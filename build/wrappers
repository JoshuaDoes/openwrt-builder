# Navigation handling
cd_pwd() {
  cd "$ROOT"
}
cd_src() {
  cd "$SRC"
}
cd_cfg() {
  cd "$CFG"
}
cd_feed() {
  cd "$FEED"
}
cd_out() {
  cd "$OUT"
}
cd_outpkg() {
  cd "$OUTPKG"
}
mkdir_out() {
  mkdir "$OUT"
}
mkdir_outpkg() {
  mkdir "$OUTPKG"
}

# Hide outputs when unnecessary
mkdir() {
  command mkdir -p "$@" >/dev/null
}
rm() {
  command rm "$@" >/dev/null
}
mv() {
  command mv "$@" >/dev/null
}
cp() {
  command cp "$@" >/dev/null
}

# Message handling
info() {
  green "$@"
}
warn() {
  yellow "$@" 2>&1
}
error() {
  red "$@" 2>&1
}

# make
clearvars() {
  . "$BUILD/clearvars"
}
clean() {
  if [ -z "$ID" ]; then
    warn "Removing all built files"
  else
    warn "Removing all built files for $ID"
    error "- $OUTPKG"
    rm -rf "$OUTPKG"
  fi
  error "- $OUT"
  rm -rf "$OUT"
}
makeprep() {
  if [ -d "$FILES" ]; then
    ln -s "$FILES" "$SRC/files"
  else
    rm -f "$SRC/files"
  fi
  config
  target
}
makereal() {
  cd_src
  command make "$@"
  cd_pwd
}

# OpenWRT commands
diffconfig() {
  cd_src
  ./scripts/diffconfig.sh > "$1"
  info "Wrote diffconfig to $1"
  cd_pwd
}
feeds() {
  cd_src
  ./scripts/feeds "$@"
  cd_pwd
}

# config
makecfg() {
  config "$@"
}
makeconf() {
  config "$@"
}
makeconfig() {
  config "$@"
}

# firmware
build() {
  firmware "$@"
}
make() {
  firmware "$@"
}

# package
makepkg() {
  package "$@"
}

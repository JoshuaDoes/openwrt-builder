package_out() {
  mkdir_outpkg
  cd_src
  pkgs="bin/packages/$CPUABI"
  if cd "$pkgs"; then
    for feed in *; do
      if [ -d "$feed" ]; then
        cd "$feed"
        for file in "$1"-*.apk "$1"-*.opkg; do
          if [ -f "$file" ]; then
            mv "$file" "$OUTPKG/"
            info "Installed $feed/$file"
          fi
        done
        cd ..
      fi
    done
  else
    error "Failed to find built package feeds for $CPUABI!"
  fi
  cd_pwd
}
package_build() {
  PACKAGE="$1"

  # Prepare the build environment
  makeprep

  # Clean any old builds of the specified package
  makereal "package/$PACKAGE/clean" -j "$(nproc)" V=s

  # Build the specified package
  makereal "package/$PACKAGE/compile" -j "$(nproc)" V=s

  # Move the final output out of the tree
  package_out "$PACKAGE"

  info "OUTPKG: $OUTPKG"
  info "$(ls -l "$OUTPKG")"
}
package() {
  if [ -z "$ID" ]; then
    error "Must lunch a target!"
  elif [ -z "$1" ]; then
    error "Must specify a package!"
  else
    package_build "$1"
  fi
}

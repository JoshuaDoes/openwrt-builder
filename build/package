package_out() {
  mkdir_outpkg
  cd_src
  pkgs="bin/packages/$CPUABI"
  if cd "$pkgs"; then
    for feed in *; do
      if [ -d "$feed" ]; then
        cd "$feed"
        for file in "$1"-*.apk "$1"_*.ipk; do
          if [ -f "$file" ]; then
            mkdir "$OUTPKG/$feed"
            mv "$file" "$OUTPKG/$feed/"
            info "Installed $feed/$file"
            warn "$(ls -l "$OUTPKG/$feed/$file")"
          fi
        done
        cd ..
      fi
    done
  else
    error "Failed to find built package feeds for $CPUABI!"
  fi
  cd_pwd
}
package_build() {
  PACKAGE="$1"

  # Prepare the build environment
  makeprep

  # Build the package after building dependencies
  makereal {toolchain,target,package/"$PACKAGE"}/compile -j "$(nproc)"

  # Move the final output out of the tree
  package_out "$PACKAGE"
}
package() {
  if [ -z "$ID" ]; then
    error "Must lunch a target!"
  elif [ -z "$1" ]; then
    error "Must specify a package!"
  else
    package_build "$1"
  fi
}

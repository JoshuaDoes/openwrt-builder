update_feeds() {
  if [ -d "$FEED" ]; then
    cd_feed
    # Start with our base feeds list
    if [ -f "feeds.conf" ]; then
      cp "feeds.conf" "$SRC/feeds.conf"
    else
      cp "$SRC/feeds.conf.default" "$SRC/feeds.conf"
    fi
    # Install our local feeds
    for feed in */; do
      if [ -d "$feed" ]; then
        feed=$(basename "$feed")
        echo "src-link $feed $FEED/$feed" >> "$SRC/feeds.conf"
      fi
    done
    # Update local git repos
    find . -type d -name .git -exec git --git-dir={} --work-tree="$PWD"/{}/.. pull \;
  fi

  # Update the package feeds
  feeds update -a
  feeds install -a

  # Download OpenWRT build dependencies (skips cached!)
  makereal download
}
update_src() {
  # Check if the source tree exists
  if [ -d "$SRC" ]; then
    # Check if we can just update the tree
    if [ -d "$SRC/.git" ]; then
      cd_src
      git pull
    else
      # Move the untracked source tree away
      mv "$SRC" "$SRC.old"
    fi
  fi
  # Clone a fresh copy if the source tree doesn't exist
  if [ ! -d "$SRC" ]; then
    git clone "$GIT" "$SRC"
  fi
}
sync() {
  # Check for OpenWRT updates
  update_src

  if [ -z "$ID" ]; then
    error "Must lunch a target to update package feeds!"
  else
    # Update feeds list and download missing build dependencies
    update_feeds
  fi
}

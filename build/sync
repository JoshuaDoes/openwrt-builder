update_feeds() {
  if [ -d "$FEED" ]; then
    cd_feed
    # Start with our base feeds list
    if [ -f "feeds.conf" ]; then
      cp "feeds.conf" "$SRC/feeds.conf"
    else
      cp "$SRC/feeds.conf.default" "$SRC/feeds.conf"
    fi
    # Install our local feeds
    for feed in *; do
      if [ -d "$feed" ]; then
        feed=$(basename "$feed")
        echo "src-link $feed $FEED/$feed" >> "$SRC/feeds.conf"
      fi
    done
    # Update local git repos
    find . -type d -name .git -exec git --git-dir={} --work-tree="$PWD"/{}/.. pull \;
  fi

  # Update the package feeds
  feeds update -a
  feeds install -a

  # Download OpenWRT build dependencies (skips cached!)
  makereal download
}
update_src() {
  # Check if the source tree exists
  if [ -d "$SRC" ]; then
    # Check if we can update the source tree
    if [ ! -d "$SRC/.git" ]; then
      # Move any untracked source tree away
      mv "$SRC" "$SRC.old"
    fi
  fi
  if [ ! -d "$SRC" ]; then
    # Clone a fresh copy if the source tree doesn't exist
    git clone "$GIT" "$SRC"
  fi
  cd_src

  # Get the current tag, defaulting to main for snapshot builds
  tag=$(git describe --exact-match --tags 2>/dev/null || echo main)

  # Allow overriding the tag
  if [ -n "$1" ]; then
    tag=$1
    case $tag in
      snapshot|master)
        tag="main"
        ;;
      release)
        tag=$(git describe --tags $(git rev-list --tags --max-count=1))
        ;;
    esac
  fi

  # Get the build type (0=snapshot, 1=release)
  type=1
  if [ "$tag" == "main" ]; then
    type=0
    warn "Checking for updates to OpenWRT snapshot"
  else
    warn "Checking for updates to OpenWRT $tag"
  fi

  # Update the source tree
  git fetch -t
  if git checkout "$tag" >/dev/null 2>&1; then
    if git symbolic-ref HEAD &>/dev/null; then
      git pull
    fi
  else
    error "Failed to switch to OpenWRT $tag!"
  fi

  cd_pwd
}
sync() {
  # Check for OpenWRT updates
  update_src "$@"

  if [ -z "$ID" ]; then
    error "Must lunch a target to update package feeds!"
  else
    # Update feeds list and download missing build dependencies
    update_feeds
  fi
}

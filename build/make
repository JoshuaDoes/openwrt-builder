makeprep() {
  # Wipe previous builds for this target
  rm -rf "$OUT"
  rm -rf "$OUTPKG"

  # Print the lunch target
  lunch_print
}
makereal() {
  command make "$@"
}

install_cfg() {
  cd_builder
  rm .config
  echo "CONFIG_TARGET_${ARCH}=y" >> .config
  echo "CONFIG_TARGET_${ARCH}_${PLATFORM}=y" >> .config
  if [ -n "$PROFILE" ] && [ "$PROFILE" != "generic" ]; then
    echo "Installing config for $ARCH/$PLATFORM/$PROFILE"
    {
      echo "CONFIG_TARGET_${ARCH}_${PLATFORM}_DEVICE_${PROFILE}=y"
      echo "CONFIG_TARGET_MULTI_PROFILE=n"
      echo "CONFIG_TARGET_ALL_PROFILES=n"
    } >> .config
  else
    echo "[TODO] Support generic profile for install_out"
    echo "Installing generic config for $ARCH/$PLATFORM"
    {
      echo "CONFIG_TARGET_MULTI_PROFILE=y"
      echo "CONFIG_TARGET_ALL_PROFILES=y"
    } >> .config
  fi
  if [ -d "$CFG" ]; then
    cd_cfg
    for cfg in */; do
      if [ -f "$cfg" ]; then
        cat "$cfg" >> "$SRC/.config"
      fi
    done
    cd_builder
  fi
  makereal defconfig
  cd_pwd
}

build_out() {
  mkdir -p "$OUT"
  for file in \
    "openwrt-$ARCH-$PLATFORM-$PROFILE-squashfs-factory.img" \
    "openwrt-$ARCH-$PLATFORM-$PROFILE-squashfs-sysupgrade.bin"
  do
    mv bin/targets/"$ARCH"/"$PLATFORM"/"$file" "$OUT/"
  done
}
build_firmware() {
  # Prepare the build environment
  makeprep

  # Navigate to our builder
  cd_builder

  # Build the OpenWRT firmware
  if [ -z "$1" ]; then
    # Use our own defaults
    makereal -j "$(nproc)" V=s
  else
    # Use the provided arguments, discarding what we'd set
    makereal "$@"
  fi

  # Move the final output out of the tree
  build_out

  # Navigate back to root
  cd_pwd

  # Check to make sure that the build succeeded
  if [ -f "$FIRMWARE" ]; then
    echo "OUT: $OUT"
    ls -l "$OUT"
  else
    error "Failed to build a firmware image!"
  fi
}
build() {
  if [ -z "$ARCH" ] || [ -z "$PLATFORM" ]; then
    error "Must lunch a target!"
  else
    build_firmware "$@"
  fi
}
make() {
  build "$@"
}

package_out() {
  mkdir -p "$OUTPKG"
  for file in "$1"-*.apk "$1"-*.opkg; do
    mv bin/packages/"$CPUABI"/*/"$file" "$OUTPKG/"
  done
}
package_build() {
  PACKAGE="$1"

  # Prepare the build environment
  makeprep

  # Navigate to our builder
  cd_builder

  # Clean any old builds of the specified package
  makereal "package/$PACKAGE/clean" -j "$(nproc)" V=s

  # Build the specified package
  makereal "package/$PACKAGE/compile" -j "$(nproc)" V=s

  # Move the final output out of the tree
  package_out "$PACKAGE"

  # Navigate back to root
  cd_pwd

  echo "OUTPKG: $OUTPKG"
  ls -l "$OUTPKG"
}
package() {
  if [ -z "$1" ]; then
    error "Must specify a package!"
  elif [ -z "$ARCH" ] || [ -z "$PLATFORM" ]; then
    error "Must lunch a target!"
  else
    package_build "$1"
  fi
}

# Using OpenWRT sysupgrade will force-close all shells.
# Be on the safe side and fork the sysupgrade script to a separate process.
## If no firmware image exists yet, one will be made to use.
## Re-run make before sysupgrade if you need to sideload fresh builds.
sysupgrade() {
  if [[ -z "$ARCH" || -z "$PLATFORM" ]]; then
    error "Must lunch a target to sysupgrade!"
  else
    if [[ -f "$FIRMWARE" ]]; then
      if [[ -f "$SYSUPGRADE" ]]; then
        bash "$SYSUPGRADE"
      else
        error "Sysupgrade script not found!"
      fi
    else
      make
      if [[ -f "$FIRMWARE" ]]; then
        bash "$SYSUPGRADE"
      else
        error "Firmware image not found!"
      fi
    fi
  fi
}

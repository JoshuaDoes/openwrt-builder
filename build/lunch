targets() {
  ls "$TARGET"
}
target() {
  if [ -z "$1" ] && [ -n "$ID" ]; then
    echo "        ID: $ID"
    echo "      ARCH: $ARCH"
    echo "  PLATFORM: $PLATFORM"
    echo "    CPUABI: $CPUABI"
    echo "   PROFILE: $PROFILE"
    echo "       OUT: $OUT"
    echo "    OUTPKG: $OUTPKG"
    echo "SYSUPGRADE: $SYSUPGRADE"
    echo "  FIRMWARE: $FIRMWARE"
  else
    lunch "$1"
  fi
}
lunch() {
  if [ -z "$1" ]; then
    error "You must specify a lunch target!"
    ls "$TARGET"
  else
    IMPORT="$1"
    if [ ! -f "$1" ]; then
      IMPORT="$TARGET/$1"
    fi
    if [ ! -f "$IMPORT" ]; then
      error "Your lunch target is not valid!"
      targets
    else
      . "$BUILD/clearvars"
      . "$IMPORT"
      export ID="$ARCH-$PLATFORM-$PROFILE"
      export IDP="$ARCH/$PLATFORM/$PROFILE"
      if [ -z "$PROFILE" ]; then
        export PROFILE="generic"
        ID="$ARCH-$PLATFORM"
        IDP="$ARCH/$PLATFORM"
      fi
      export OUT="$ROOT/out/$IDP"
      export OUTPKG="$OUT/packages"
      export FIRMWARE="$OUT/openwrt-$ID-squashfs-sysupgrade.bin"
      export SYSUPGRADE="sysupgrade/$ID"
      config
      target
    fi
  fi
}

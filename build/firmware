firmware_out() {
  mkdir_out
  cd_src
  for file in \
    "openwrt-$ID-squashfs-factory.img" \
    "openwrt-$ID-squashfs-factory.bin" \
    "openwrt-$ID-squashfs-sysupgrade.bin" \
    "openwrt-$ID-fastboot-boot.img"
  do
    if mv bin/targets/"$ARCH"/"$PLATFORM"/"$file" "$OUT/" 2>/dev/null; then
      info "Installed $file"
      warn "$(ls -l "$OUT/$file")"
    fi
  done
  cd_pwd
}
firmware_build() {
  # Prepare the build environment
  makeprep

  # Build the OpenWRT firmware
  if [ -z "$1" ]; then
    # Use our own defaults
    makereal -j "$(nproc)"
  else
    # Use the provided arguments, discarding what we'd set
    makereal "$@"
  fi

  # Move the final output out of the tree
  firmware_out

  # Check to make sure that the build succeeded
  if [ ! -f "$FIRMWARE" ]; then
    error "Failed to build a firmware image!"
  fi
}
firmware() {
  if [ -z "$ID" ]; then
    error "Must lunch a target!"
  else
    firmware_build "$@"
  fi
}

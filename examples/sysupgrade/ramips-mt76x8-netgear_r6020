# This sample only works if you have the `openssh-scp-server` package on your OpenWRT host!
## If installing it is not an option for you, consider writing (and submitting!) a custom alternative.

# Import the build environment to access its commands.
## Copy out the firmware image path, it will be overwritten by this.
FW="$FIRMWARE"
. "$BUILD/envsetup"

# Don't exit when commands return an error code
set +e

# Define the host of your OpenWRT SSH server.
## If you need to use a custom port, consider setting up a ~/.ssh/config host for it.
HOST="openwrt"

# Define the filename from the build framework and where to install it.
## OpenWRT sysupgrade requires the install location be from /tmp due to limited storage sizes.
## It might help to add a check to make sure there's enough free space in the tmpfs mount.
NAME=$(basename "$FW")
INST="/tmp/$NAME"
echo "Sideloading now: $NAME"

# Upload the firmware to the host with SCP.
if scp "$FW" "$HOST:$INST"; then
  # Use SSH to run sysupgrade on the host.
  # It will close all shells, which forcefully ends our connection.
  ## It would be wise to use this opportunity to check the returned error if automation is a concern.
  ## Otherwise, just pay attention like you would while doing a manual install. 
  ssh "$HOST" sysupgrade -v "$INST"
else
  error "Failed to upload the firmware image!"
fi



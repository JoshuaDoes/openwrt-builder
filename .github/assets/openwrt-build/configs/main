# Advanced features for developers
CONFIG_DEVEL=y

# Dead code and data elimination for all packages
CONFIG_USE_GC_SECTIONS=y

# Use ccache to improve performance of fresh rebuilds
CONFIG_CCACHE=y

# Make debug logs reproducible
CONFIG_REPRODUCIBLE_DEBUG_INFO=y

# Build patented code if a package wants to
CONFIG_BUILD_PATENTED=y

# Version configuration
CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_BUG_URL="https://github.com/JoshuaDoes/openwrt-builder/issues"
CONFIG_VERSION_CODE=""
CONFIG_VERSION_DIST="OpenWrt"
CONFIG_VERSION_FIRMWARE_URL=""
CONFIG_VERSION_HOME_URL="https://github.com/JoshuaDoes/openwrt-builder/releases"
CONFIG_VERSION_HWREV=""
CONFIG_VERSION_MANUFACTURER="JoshuaDoes"
CONFIG_VERSION_MANUFACTURER_URL="https://github.com/JoshuaDoes"
CONFIG_VERSION_NUMBER=""
# CONFIG_VERSION_REPO is not set
CONFIG_VERSION_SUPPORT_URL=""
# CONFIG_VERSION_CODE_FILENAMES is not set
# CONFIG_VERSION_FILENAMES is not set

# Use the latest Linux LTS kernel if the lunch target supports it
CONFIG_TESTING_KERNEL=y

# Build dropbear with ed25519 (including security) key support
CONFIG_DROPBEAR_ED25519=y
CONFIG_DROPBEAR_ED25519_SK=y

# Install an SFTP server for smooth sideloading support
CONFIG_PACKAGE_openssh-sftp-server=y

# Install nano as a vim alternative
CONFIG_PACKAGE_nano-full=y

# Install sshfs to be able to mount SSH remotes as network drives
CONFIG_PACKAGE_sshfs=y

# Install LuCI
CONFIG_PACKAGE_luci=y

# Install our Material Design 3 theme for LuCI
CONFIG_PACKAGE_luci-theme-material3=y

# Add support for DNS over HTTPS with a LuCI app
#CONFIG_PACKAGE_luci-app-https-dns-proxy=y
